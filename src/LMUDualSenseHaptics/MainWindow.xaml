<Window x:Class="LMUDualSenseHaptics.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LMU · DualSense Haptics v1.5"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        Style="{StaticResource {x:Type Window}}" Width="1040" Height="900" MinWidth="820" MinHeight="640">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource SurfaceBrush}" Padding="28,20" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="DualSense Haptics" FontSize="26" FontWeight="SemiBold" LineHeight="34"/>
                    <TextBlock Text="LE MANS ULTIMATE  /  v1.5 · USB 手柄反馈" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ThemeButton" Content="深色外观" Style="{StaticResource TextButton}" Click="ThemeClick"/>
                    <Button Content="保存配置" Style="{StaticResource PrimaryButton}" Click="SaveClick" Margin="0,0,0,8"/>
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,24,28,16">
                <Border Style="{StaticResource Card}"><StackPanel>
                    <TextBlock Text="开始使用" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="1. 用 USB 数据线连接 DualSense，并关闭其他软件的手柄震动。"/>
                    <TextBlock Text="2. 在“路面与震动”中选择手柄音频设备；在“连接与工具”中检查左右震动。" Margin="0,4,0,0"/>
                    <TextBlock Text="3. 启动 LMU 并进入驾驶，按喜好调节反馈强度，然后保存配置。" Margin="0,4,0,0"/>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Right" Background="{DynamicResource PrimaryContainerBrush}" CornerRadius="14" Padding="12,5" Margin="16,0,0,0" VerticalAlignment="Top">
                                <TextBlock x:Name="DeviceChip" Text="请连接手柄" Foreground="{DynamicResource OnPrimaryContainerBrush}" FontSize="12"/>
                            </Border>
                            <TextBlock x:Name="StateText" Text="等待启动 LMU" FontSize="22" FontWeight="SemiBold" LineHeight="30"/>
                        </DockPanel>
                        <TextBlock x:Name="CarText" Text="通过 USB 连接 DualSense，进入 LMU 驾驶后自动启用反馈。" Margin="0,8,0,0"/>
                        <TextBlock x:Name="ConnectionText" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                        <Border x:Name="ErrorBanner" Visibility="Collapsed" Background="{DynamicResource ErrorContainerBrush}" Padding="12" CornerRadius="10" Margin="0,14,0,0">
                            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>
                <UniformGrid Columns="4" Margin="0,0,-12,22">
                    <Border Style="{StaticResource MetricCard}"><StackPanel>
                        <TextBlock Text="L2 · 刹车" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="BrakeOutputText" Text="释放" FontSize="20" LineHeight="28" Margin="0,8,0,10"/>
                        <ProgressBar x:Name="BrakeMeter" Maximum="8" AutomationProperties.Name="L2 刹车反馈强度"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource MetricCard}"><StackPanel>
                        <TextBlock Text="R2 · 油门" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="ThrottleOutputText" Text="自由行程" FontSize="20" LineHeight="28" Margin="0,8,0,10"/>
                        <ProgressBar x:Name="ThrottleMeter" Maximum="8" AutomationProperties.Name="R2 油门反馈强度"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource MetricCard}"><StackPanel>
                        <TextBlock Text="左握把 · 输出" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="LeftGripText" Text="0 / 255" FontSize="20" LineHeight="28" Margin="0,8,0,10"/>
                        <ProgressBar x:Name="LeftGripMeter" Maximum="255" AutomationProperties.Name="左握把输出电平"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource MetricCard}"><StackPanel>
                        <TextBlock Text="右握把 · 输出" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="RightGripText" Text="0 / 255" FontSize="20" LineHeight="28" Margin="0,8,0,10"/>
                        <ProgressBar x:Name="RightGripMeter" Maximum="255" AutomationProperties.Name="右握把输出电平"/>
                    </StackPanel></Border>
                </UniformGrid>
                <TabControl>
                    <TabItem Header="扳机反馈">
                        <StackPanel x:Name="TriggerSettingsRoot">
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="车辆扳机配置" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="ActiveTriggerProfileText" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                                <ComboBox x:Name="VehicleTriggerChoice" DisplayMemberPath="Name" SelectionChanged="VehicleTriggerChoiceChanged" AutomationProperties.Name="编辑车辆扳机配置"/>
                                <CheckBox x:Name="FollowVehicleCheck" Content="编辑面板跟随当前车辆" IsChecked="True" Checked="FollowVehicleChanged" Unchecked="FollowVehicleChanged" Margin="0,8,0,0"/>
                                <TextBlock x:Name="TriggerScopeHint" Style="{StaticResource Muted}" Margin="0,8,0,12"/>
                                <WrapPanel>
                                    <Button x:Name="CreateVehicleButton" Content="为此车创建配置" Click="CreateVehicleClick" Style="{StaticResource PrimaryButton}"/>
                                    <Button x:Name="RemoveVehicleButton" Content="删除此车配置" Click="RemoveVehicleClick" Style="{StaticResource OutlineButton}"/>
                                    <Button Content="导入车辆配置" Click="ImportVehicleClick"/>
                                    <Button x:Name="ExportVehicleButton" Content="分享此车配置" Click="ExportVehicleClick"/>
                                    <Button Content="保存配置" Click="SaveClick"/>
                                </WrapPanel>
                                <TextBlock Text="输出始终按游戏识别到的车型自动切换；编辑其他车辆不会切换当前车辆的反馈。握把震动、音频和外观保持通用。" Style="{StaticResource Muted}"/>
                            </StackPanel></Border>
                            <StackPanel x:Name="TriggerEditor">
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="R2 油门" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="牵引力控制（TC）介入时，R2 增加阻力，帮助感知加速打滑。开启下方选项后，正常加速时 R2 保持自由行程。" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                                <CheckBox x:Name="TcOnlyCheck" Content="仅 TC 介入时增加阻力" Checked="ThrottleModeChanged" Unchecked="ThrottleModeChanged"/>
                                <StackPanel x:Name="ThrottleSettings" Margin="0,8,0,0"/>
                                <Expander Header="R2 其他效果">
                                    <StackPanel><TextBlock x:Name="LegacyHint" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                                        <StackPanel x:Name="ExtraTriggerSettings"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="L2 刹车" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="自动模式：GT3 使用旧版 LT；其他车型使用轻基础阻力、临界滑移增阻和抱死脉冲。每次换车都会重新识别。" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                                <ComboBox x:Name="BrakeModeChoice" SelectionChanged="BrakeModeChanged" Margin="0,4,0,8" AutomationProperties.Name="刹车反馈模式">
                                    <ComboBoxItem Content="自动切换：GT3 旧版 / 其他车型预测"/>
                                    <ComboBoxItem Content="手动：ABS 介入阻力墙"/>
                                    <ComboBoxItem Content="手动：预测临界阻力"/>
                                </ComboBox>
                                <TextBlock Text="未标定时不输出参考墙；临界提示需要有效纵向接触区速度。行程映射默认线性，可按游戏死区和曲线校准。" Style="{StaticResource Muted}"/>
                                <StackPanel x:Name="BrakeSettings"/>
                            </StackPanel></Border>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="路面与震动">
                        <StackPanel x:Name="VibrationSettingsRoot">
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="路面与路肩" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="根据车辆数据，让左右握把分别呈现路面颠簸和路肩振动。音圈是手柄内的触觉振动部件。" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                                <CheckBox x:Name="AudioModeCheck" Content="使用 USB 音圈震动（推荐）" Checked="AudioOptionsChanged" Unchecked="AudioOptionsChanged"/>
                                <TextBlock Text="手柄音频设备" Style="{StaticResource Muted}" Margin="0,12,0,4"/>
                                <ComboBox x:Name="AudioDevicesCombo" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="AudioDeviceChanged"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="刷新音频设备" Click="RefreshAudioDevicesClick"/>
                                    <Button Content="Windows 声音设置" Click="SoundSettingsClick" Style="{StaticResource OutlineButton}"/>
                                </WrapPanel>
                                <TextBlock x:Name="AudioStatusText" Style="{StaticResource Muted}" Margin="0,6,0,8"/>
                                <CheckBox x:Name="SwapAudioSidesCheck" Content="交换左右震动（方向相反时开启）" Checked="AudioOptionsChanged" Unchecked="AudioOptionsChanged"/>
                                <CheckBox x:Name="KerbFallbackCheck" Content="根据连续颠簸补充路肩识别" Checked="AudioOptionsChanged" Unchecked="AudioOptionsChanged"/>
                                <TextBlock Text="缺少路肩标记时，用单侧连续颠簸推断路肩；普通粗糙路面也可能触发，可按喜好关闭。" Style="{StaticResource Muted}" Margin="0,4,0,8"/>
                                <TextBlock Text="关闭 USB 音圈后，握把改用普通震动。游戏声音请继续使用耳机或音箱。" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                                <StackPanel x:Name="AudioSettings" Margin="0,10,0,12"/>
                                <StackPanel x:Name="RoadSettings"/>
                                <StackPanel x:Name="SpatialSettings" Margin="0,12,0,0"/>
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="车辆与事件" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="提供引擎、换挡、轮胎打滑和碰撞提示。引擎震动随转速变化，路面和路肩反馈优先。" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                                <StackPanel x:Name="OtherGripSettings"/>
                            </StackPanel></Border>
                            <TextBlock Text="先调整路面和路肩，再按喜好增加其他效果。顶部握把读数显示软件输出电平，可用于确认是否正在输出。" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="连接与工具">
                        <StackPanel>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="运行信息" Style="{StaticResource SectionTitle}"/>
                                <Expander Header="查看详细运行信息"><StackPanel>
                                <TextBlock x:Name="ValidationText" Style="{StaticResource Muted}" Margin="0,0,0,14"/>
                                <TextBlock x:Name="EventsText" TextWrapping="Wrap" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"/>
                                <Expander Header="车轮数据与路面识别"><TextBlock x:Name="WheelsText" TextWrapping="Wrap" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"/></Expander>
                                <Expander Header="性能与日志详情"><TextBlock x:Name="PerformanceText" Style="{StaticResource Muted}"/></Expander>
                                </StackPanel></Expander>
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="手柄检查" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="离开驾驶后，点击按钮检查左右震动和扳机阻力，每次持续 1 秒。先确认手柄有反馈，再进入游戏。" Style="{StaticResource Muted}" Margin="0,0,0,14"/>
                                <WrapPanel x:Name="DeviceTestsPanel">
                                    <Button Content="左握把震动" Tag="AUDIO_LEFT" Click="DeviceTestClick"/>
                                    <Button Content="右握把震动" Tag="AUDIO_RIGHT" Click="DeviceTestClick"/>
                                    <Button Content="左侧路肩震动" Tag="AUDIO_KERB_LEFT" Click="DeviceTestClick"/>
                                    <Button Content="右侧路肩震动" Tag="AUDIO_KERB_RIGHT" Click="DeviceTestClick"/>
                                    <Button Content="L2 阻力" Tag="L2" Click="DeviceTestClick"/>
                                    <Button Content="R2 阻力" Tag="R2" Click="DeviceTestClick"/>
                                    <Button Content="左握把普通震动" Tag="LEFT" Click="DeviceTestClick"/>
                                    <Button Content="右握把普通震动" Tag="RIGHT" Click="DeviceTestClick"/>
                                    <Button Content="L2 脉冲" Tag="PULSE_L2" Click="DeviceTestClick"/>
                                    <Button Content="R2 脉冲" Tag="PULSE_R2" Click="DeviceTestClick"/>
                                    <Button Content="停止检查" Tag="OFF" Click="DeviceTestClick" Style="{StaticResource OutlineButton}"/>
                                </WrapPanel>
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="配置与日志" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="设置修改后立即生效；点击“保存配置”可供下次启动使用。遇到问题时，可记录驾驶数据并打开日志文件夹。录制期间无法更改反馈设置。" Style="{StaticResource Muted}" Margin="0,0,0,14"/>
                                <WrapPanel>
                                    <Button x:Name="RecordButton" Content="开始记录驾驶数据" Click="RecordClick"/>
                                    <Button Content="打开日志文件夹" Click="LogsClick"/>
                                    <Button Content="导入车型预设" Click="ImportPresetClick"/>
                                    <Button Content="导出车型模板" Click="ExportPresetClick"/>
                                    <Button Content="恢复全部默认值" Click="ResetClick" Style="{StaticResource OutlineButton}"/>
                                </WrapPanel>
                            </StackPanel></Border>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceLowBrush}" Padding="28,10">
            <DockPanel><TextBlock DockPanel.Dock="Right" Text="USB 连接" Style="{StaticResource Muted}" Margin="20,0,0,0"/>
                <TextBlock x:Name="NoticeText" Text="请关闭 Steam Input 等软件对该手柄的震动输出。游戏声音请使用耳机或音箱。" Style="{StaticResource Muted}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
