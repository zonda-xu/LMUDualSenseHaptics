<Window x:Class="LMUDualSenseHaptics.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LMU · DualSense Haptics v1.6-preview"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        Style="{StaticResource {x:Type Window}}" Width="1040" Height="900" MinWidth="820" MinHeight="640">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource SurfaceBrush}" Padding="28,20" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="0,0,0,1">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="DualSense Haptics" FontSize="26" FontWeight="SemiBold" LineHeight="34"/>
                    <TextBlock Text="{DynamicResource Text_3AE99AE45A}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>
                <WrapPanel Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Text_9F6FEE1ABA}" VerticalAlignment="Center" Margin="0,0,10,8"/>
                    <ComboBox x:Name="LanguageChoice" Width="170" DisplayMemberPath="Name" SelectedValuePath="Code"
                              SelectionChanged="LanguageChanged" FlowDirection="LeftToRight" AutomationProperties.AutomationId="LanguageChoice"
                              AutomationProperties.Name="{DynamicResource Text_3D13868593}" Margin="0,0,16,8"/>
                    <Button x:Name="ThemeButton" Content="{DynamicResource Text_46BAD67D06}" Style="{StaticResource TextButton}" Click="ThemeClick"/>
                    <Button Content="{DynamicResource Text_6E584E3D5C}" Style="{StaticResource PrimaryButton}" Click="SaveClick" Margin="0,0,0,8"/>
                </WrapPanel>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,24,28,16">
                <Border Style="{StaticResource Card}"><StackPanel>
                    <TextBlock Text="{DynamicResource Text_715EE9DC84}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{DynamicResource Text_806C22EC99}"/>
                    <TextBlock Text="{DynamicResource Text_16AF1B2544}" Margin="0,4,0,0"/>
                    <TextBlock Text="{DynamicResource Text_BA50D361BB}" Margin="0,4,0,0"/>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Right" Background="{DynamicResource PrimaryContainerBrush}" CornerRadius="14" Padding="12,5" Margin="16,0,0,0" VerticalAlignment="Top">
                                <TextBlock x:Name="DeviceChip" Text="{DynamicResource Text_6CA7C4BB3C}" Foreground="{DynamicResource OnPrimaryContainerBrush}" FontSize="12"/>
                            </Border>
                            <TextBlock x:Name="StateText" Text="{DynamicResource Text_84CD590732}" FontSize="22" FontWeight="SemiBold" LineHeight="30"/>
                        </DockPanel>
                        <TextBlock x:Name="CarText" Text="{DynamicResource Text_792FC92035}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="ConnectionText" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                        <Border x:Name="ErrorBanner" Visibility="Collapsed" Background="{DynamicResource ErrorContainerBrush}" Padding="12" CornerRadius="10" Margin="0,14,0,0">
                            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>
                <UniformGrid FlowDirection="LeftToRight" Columns="4" Margin="0,0,-12,22">
                    <Border Style="{StaticResource MetricCard}"><StackPanel>
                        <TextBlock Text="{DynamicResource Text_1FBEFDC9D8}" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="BrakeOutputText" Text="{DynamicResource Text_CC3D94550A}" FontSize="20" LineHeight="28" Margin="0,8,0,10"/>
                        <ProgressBar x:Name="BrakeMeter" Maximum="8" AutomationProperties.Name="{DynamicResource Text_3C8BE280ED}"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource MetricCard}"><StackPanel>
                        <TextBlock Text="{DynamicResource Text_28C6F89472}" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="ThrottleOutputText" Text="{DynamicResource Text_39A65126C1}" FontSize="20" LineHeight="28" Margin="0,8,0,10"/>
                        <ProgressBar x:Name="ThrottleMeter" Maximum="8" AutomationProperties.Name="{DynamicResource Text_90E0FA56F1}"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource MetricCard}"><StackPanel>
                        <TextBlock Text="{DynamicResource Text_165C9C148F}" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="LeftGripText" Text="0 / 255" FontSize="20" LineHeight="28" Margin="0,8,0,10"/>
                        <ProgressBar x:Name="LeftGripMeter" Maximum="255" AutomationProperties.Name="{DynamicResource Text_B4CDF01F77}"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource MetricCard}"><StackPanel>
                        <TextBlock Text="{DynamicResource Text_208AA5333A}" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="RightGripText" Text="0 / 255" FontSize="20" LineHeight="28" Margin="0,8,0,10"/>
                        <ProgressBar x:Name="RightGripMeter" Maximum="255" AutomationProperties.Name="{DynamicResource Text_33038B05E5}"/>
                    </StackPanel></Border>
                </UniformGrid>
                <TabControl x:Name="SettingsTabs">
                    <TabItem Header="{DynamicResource Text_3F33F2BC25}">
                        <StackPanel x:Name="TriggerSettingsRoot">
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="{DynamicResource Text_187C712792}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="ActiveTriggerProfileText" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                                <ComboBox x:Name="VehicleTriggerChoice" DisplayMemberPath="Name" SelectionChanged="VehicleTriggerChoiceChanged" AutomationProperties.Name="{DynamicResource Text_7D63662AFD}"/>
                                <CheckBox x:Name="FollowVehicleCheck" Content="{DynamicResource Text_58AFA02920}" IsChecked="True" Checked="FollowVehicleChanged" Unchecked="FollowVehicleChanged" Margin="0,8,0,0"/>
                                <TextBlock x:Name="TriggerScopeHint" Style="{StaticResource Muted}" Margin="0,8,0,12"/>
                                <WrapPanel>
                                    <Button x:Name="CreateVehicleButton" Content="{DynamicResource Text_D987F2228A}" Click="CreateVehicleClick" Style="{StaticResource PrimaryButton}"/>
                                    <Button x:Name="RemoveVehicleButton" Content="{DynamicResource Text_9D6A52C62E}" Click="RemoveVehicleClick" Style="{StaticResource OutlineButton}"/>
                                    <Button AutomationProperties.AutomationId="ImportVehicleButton" Content="{DynamicResource Text_340152EE2E}" Click="ImportVehicleClick"/>
                                    <Button x:Name="ExportVehicleButton" Content="{DynamicResource Text_317EF7EEE3}" Click="ExportVehicleClick"/>
                                    <Button Content="{DynamicResource Text_6E584E3D5C}" Click="SaveClick"/>
                                </WrapPanel>
                                <TextBlock Text="{DynamicResource Text_8AD2E87E61}" Style="{StaticResource Muted}"/>
                            </StackPanel></Border>
                            <StackPanel x:Name="TriggerEditor">
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="{DynamicResource Text_D1275A479D}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{DynamicResource Text_2E7F9205BA}" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                                <CheckBox x:Name="TcOnlyCheck" Content="{DynamicResource Text_1C8C11D711}" Checked="ThrottleModeChanged" Unchecked="ThrottleModeChanged"/>
                                <StackPanel x:Name="ThrottleSettings" Margin="0,8,0,0"/>
                                <Expander Header="{DynamicResource Text_E921FA08E6}">
                                    <StackPanel><TextBlock x:Name="LegacyHint" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                                        <StackPanel x:Name="ExtraTriggerSettings"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="{DynamicResource Text_1F6F1B53A8}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{DynamicResource Text_A79F010861}" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                                <ComboBox x:Name="BrakeModeChoice" SelectionChanged="BrakeModeChanged" Margin="0,4,0,8" AutomationProperties.Name="{DynamicResource Text_B8C96E18C6}">
                                    <ComboBoxItem Content="{DynamicResource Text_0A29514732}"/>
                                    <ComboBoxItem Content="{DynamicResource Text_79E093AAFF}"/>
                                    <ComboBoxItem Content="{DynamicResource Text_BC9CFECA52}"/>
                                </ComboBox>
                                <TextBlock Text="{DynamicResource Text_1F555EDE24}" Style="{StaticResource Muted}"/>
                                <StackPanel x:Name="BrakeSettings"/>
                            </StackPanel></Border>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="{DynamicResource Text_A79DB89F2C}">
                        <StackPanel x:Name="VibrationSettingsRoot">
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="{DynamicResource Text_04CEFF0191}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{DynamicResource Text_D0F3713361}" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                                <CheckBox x:Name="AudioModeCheck" Content="{DynamicResource Text_86637974F1}" Checked="AudioOptionsChanged" Unchecked="AudioOptionsChanged"/>
                                <TextBlock Text="{DynamicResource Text_4242EDC048}" Style="{StaticResource Muted}" Margin="0,12,0,4"/>
                                <ComboBox x:Name="AudioDevicesCombo" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="AudioDeviceChanged"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="{DynamicResource Text_E18B4C0293}" Click="RefreshAudioDevicesClick"/>
                                    <Button Content="{DynamicResource Text_3BB1B8846F}" Click="SoundSettingsClick" Style="{StaticResource OutlineButton}"/>
                                </WrapPanel>
                                <TextBlock x:Name="AudioStatusText" Style="{StaticResource Muted}" Margin="0,6,0,8"/>
                                <CheckBox x:Name="SwapAudioSidesCheck" Content="{DynamicResource Text_BA62B35482}" Checked="AudioOptionsChanged" Unchecked="AudioOptionsChanged"/>
                                <CheckBox x:Name="KerbFallbackCheck" Content="{DynamicResource Text_9A87D338FC}" Checked="AudioOptionsChanged" Unchecked="AudioOptionsChanged"/>
                                <TextBlock Text="{DynamicResource Text_B8EA8BC30D}" Style="{StaticResource Muted}" Margin="0,4,0,8"/>
                                <TextBlock Text="{DynamicResource Text_68F1F21AB8}" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                                <StackPanel x:Name="AudioSettings" Margin="0,10,0,12"/>
                                <StackPanel x:Name="RoadSettings"/>
                                <StackPanel x:Name="SpatialSettings" Margin="0,12,0,0"/>
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="{DynamicResource Text_A448323A2D}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{DynamicResource Text_0FE50CDBBC}" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                                <StackPanel x:Name="OtherGripSettings"/>
                            </StackPanel></Border>
                            <TextBlock Text="{DynamicResource Text_05FB1DD36C}" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="{DynamicResource Text_BC45E9FF9B}">
                        <StackPanel>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="{DynamicResource Text_0020A68469}" Style="{StaticResource SectionTitle}"/>
                                <Expander Header="{DynamicResource Text_E364688B89}"><StackPanel>
                                <TextBlock x:Name="ValidationText" Style="{StaticResource Muted}" Margin="0,0,0,14"/>
                                <TextBlock FlowDirection="LeftToRight" x:Name="EventsText" TextWrapping="Wrap" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"/>
                                <Expander Header="{DynamicResource Text_4BBB2FDDC6}"><TextBlock FlowDirection="LeftToRight" x:Name="WheelsText" TextWrapping="Wrap" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"/></Expander>
                                <Expander Header="{DynamicResource Text_368393FDEB}"><TextBlock FlowDirection="LeftToRight" x:Name="PerformanceText" Style="{StaticResource Muted}"/></Expander>
                                </StackPanel></Expander>
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="{DynamicResource Text_20BFE98375}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{DynamicResource Text_B3E9372DD5}" Style="{StaticResource Muted}" Margin="0,0,0,14"/>
                                <WrapPanel x:Name="DeviceTestsPanel">
                                    <Button Content="{DynamicResource Text_8942CDC6EE}" Tag="AUDIO_LEFT" Click="DeviceTestClick"/>
                                    <Button Content="{DynamicResource Text_9509F7F537}" Tag="AUDIO_RIGHT" Click="DeviceTestClick"/>
                                    <Button Content="{DynamicResource Text_01E7601A50}" Tag="AUDIO_KERB_LEFT" Click="DeviceTestClick"/>
                                    <Button Content="{DynamicResource Text_47AD24864F}" Tag="AUDIO_KERB_RIGHT" Click="DeviceTestClick"/>
                                    <Button Content="{DynamicResource Text_4A02B0AEBC}" Tag="L2" Click="DeviceTestClick"/>
                                    <Button Content="{DynamicResource Text_00710F2F6D}" Tag="R2" Click="DeviceTestClick"/>
                                    <Button Content="{DynamicResource Text_8EA315C2F6}" Tag="LEFT" Click="DeviceTestClick"/>
                                    <Button Content="{DynamicResource Text_7CE63073F4}" Tag="RIGHT" Click="DeviceTestClick"/>
                                    <Button Content="{DynamicResource Text_4B8026B2D8}" Tag="PULSE_L2" Click="DeviceTestClick"/>
                                    <Button Content="{DynamicResource Text_3C86072E61}" Tag="PULSE_R2" Click="DeviceTestClick"/>
                                    <Button Content="{DynamicResource Text_D4708FD98D}" Tag="OFF" Click="DeviceTestClick" Style="{StaticResource OutlineButton}"/>
                                </WrapPanel>
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="{DynamicResource Text_CF47F42F64}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{DynamicResource Text_14FE22EC16}" Style="{StaticResource Muted}" Margin="0,0,0,14"/>
                                <WrapPanel>
                                    <Button x:Name="RecordButton" Content="{DynamicResource Text_F04853B20F}" Click="RecordClick"/>
                                    <Button Content="{DynamicResource Text_2E765B0E76}" Click="LogsClick"/>
                                    <Button Content="{DynamicResource Text_6FD6301C13}" Click="ImportPresetClick"/>
                                    <Button Content="{DynamicResource Text_D77C138825}" Click="ExportPresetClick"/>
                                    <Button Content="{DynamicResource Text_80FBA41DC5}" AutomationProperties.AutomationId="ResetDefaultsButton" Click="ResetClick" Style="{StaticResource OutlineButton}"/>
                                </WrapPanel>
                            </StackPanel></Border>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceLowBrush}" Padding="28,10">
            <DockPanel><TextBlock DockPanel.Dock="Right" Text="{DynamicResource Text_68E7CF83A0}" Style="{StaticResource Muted}" Margin="20,0,0,0"/>
                <TextBlock x:Name="NoticeText" Text="{DynamicResource Text_B7A9555934}" Style="{StaticResource Muted}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
